# Mẫu biến môi trường cho dich-vu/gpu-node — chép thành .env rồi sửa.
# Một lệnh dựng:  docker compose up -d   (đọc COMPOSE_PROFILES ở dưới)

# Dịch vụ bật theo profile (cách nhau bằng dấu phẩy): nghe, thi-giac, tach-am
COMPOSE_PROFILES=nghe

# Địa chỉ LAN của máy GPU mà cổng công bố ra (KHÔNG để 0.0.0.0 nếu không cần).
# Ví dụ mạng nhà: GPU_NODE_BIND=192.168.1.50
GPU_NODE_BIND=127.0.0.1

# Thư mục dữ liệu trên máy chủ (model, khoá nút, log). Bind mount để nhìn/sao lưu.
GPU_NODE_DATA=./du-lieu

# Tên hiển thị của nút trong web2api.
GPU_NODE_TEN=Máy GPU

# Danh sách IP được phép gọi cổng, cách nhau dấu phẩy (rỗng = mọi IP gọi tới).
# Khuyên đặt IP của máy chạy web2api, ví dụ: GPU_NODE_IP_CHO_PHEP=192.168.1.10
GPU_NODE_IP_CHO_PHEP=

# Số lượt chạy đồng thời tối đa của cả nút (một card 8 GB nên để 1).
GPU_NODE_DONG_THOI=1

# Model nghe (faster-whisper): large-v3 (≥8 GB VRAM, int8_float16) hoặc medium.
FW_MODEL=large-v3
FW_COMPUTE=int8_float16

# Model tách âm (audio-separator, ONNX).
TACH_AM_MODEL=MDX23C.onnx
